+++ b/app/src/main/java/me/phh/treble/app/Settings.kt
@@ -1,6 +1,7 @@
 package me.phh.treble.app
 
 import android.os.Bundle
+import android.view.View
 import androidx.annotation.XmlRes
 import androidx.preference.ListPreference
 import androidx.preference.Preference
@@ -40,6 +41,13 @@ abstract class SettingsFragment : PreferenceFragmentCompat() {
         addPreferencesFromResource(preferencesResId)
     }
 
+    override fun onViewCreated(view: View, savedInstanceState: Bundle?) {
+        super.onViewCreated(view, savedInstanceState)
+        // flat list: no separators between preferences or categories
+        setDivider(null)
+        setDividerHeight(0)
+    }
+
     override fun onResume() {
         super.onResume()
         activity?.title = arguments?.getString("title")
diff --git a/app/src/main/java/me/phh/treble/app/SettingsActivity.kt b/app/src/main/java/me/phh/treble/app/SettingsActivity.kt
index a55f1d9..843da66 100644
--- a/app/src/main/java/me/phh/treble/app/SettingsActivity.kt
+++ b/app/src/main/java/me/phh/treble/app/SettingsActivity.kt
@@ -4,22 +4,26 @@ import android.content.Intent
 import android.os.Bundle
 import android.os.UserHandle
 import androidx.appcompat.app.AppCompatActivity
+import com.google.android.material.color.DynamicColors
 
 class SettingsActivity : AppCompatActivity() {
 
     override fun onCreate(savedInstanceState: Bundle?) {
+        DynamicColors.applyToActivityIfAvailable(this)
         super.onCreate(savedInstanceState)
         applicationContext.startServiceAsUser(
             Intent(applicationContext, EntryService::class.java),
             UserHandle.SYSTEM
         )
         setContentView(R.layout.activity_settings)
+        setSupportActionBar(findViewById(R.id.action_bar))
         if (supportFragmentManager.findFragmentById(R.id.settings_container) == null) {
             supportFragmentManager.beginTransaction()
                 .replace(R.id.settings_container, MainSettingsFragment())
                 .commit()
         }
         supportActionBar?.setDisplayHomeAsUpEnabled(true)
+        supportActionBar?.setHomeAsUpIndicator(R.drawable.ic_arrow_back)
     }
 
     override fun onSupportNavigateUp(): Boolean {
diff --git a/app/src/main/java/me/phh/treble/app/UpdaterActivity.kt b/app/src/main/java/me/phh/treble/app/UpdaterActivity.kt
