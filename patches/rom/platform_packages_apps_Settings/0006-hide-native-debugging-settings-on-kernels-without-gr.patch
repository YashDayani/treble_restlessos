From bb306ed3640baca763d23db1a7e14377759eb988 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Mon, 12 Oct 2026 13:58:31 +0100
Subject: [PATCH 6/6] hide native debugging settings on kernels without grapheneos
 flags

blocking native debugging is enforced via the grapheneos kernel
patches (/proc/self/attr/grapheneos_flags). on GSI kernels without
that support the toggle is a no-op, so hide it: the exploit protection
default entry, the per-app list entry, and the per-app preference all
check SELinuxFlags.kernelSupportsSELinuxFlags() and hide when absent.
---
 .../applications/AppNativeDebugging.kt        | 19 +++++++++++++++++--
 1 file changed, 17 insertions(+), 2 deletions(-)

diff --git a/src/com/android/settings/applications/AppNativeDebugging.kt b/src/com/android/settings/applications/AppNativeDebugging.kt
index 52ab5b9..37b0dcd 100644
--- a/src/com/android/settings/applications/AppNativeDebugging.kt
+++ b/src/com/android/settings/applications/AppNativeDebugging.kt
@@ -9,6 +9,7 @@ import android.ext.settings.app.AswDenyNativeDebug
 import androidx.compose.runtime.Composable
 import androidx.compose.ui.platform.LocalContext
 import androidx.preference.PreferenceScreen
+import com.android.internal.os.SELinuxFlags
 import com.android.settings.R
 import com.android.settings.ext.AppPrefUtils
 import com.android.settings.ext.BoolSettingFragment
@@ -33,6 +34,12 @@ object AswAdapterNativeDebugging : AswAdapter<AswDenyNativeDebug>() {
 
 @Composable
 fun AppNativeDebuggingPreference(app: ApplicationInfo) {
+    if (!SELinuxFlags.kernelSupportsSELinuxFlags()) {
+        // blocking native debugging needs the grapheneos kernel patches;
+        // hide the no-op toggle on GSI kernels without them
+        return
+    }
+
     val context = LocalContext.current
     AswPreference(context, app, AswAdapterNativeDebugging)
 }
@@ -57,6 +64,11 @@ class AppNativeDebuggingFragment : AswExploitProtectionFragment<AswDenyNativeDeb
 class AppDefaultNativeDebuggingPrefController(ctx: Context, key: String) :
     BoolSettingFragmentPrefController(ctx, key, ExtSettings.ALLOW_NATIVE_DEBUG_BY_DEFAULT) {
 
+    // blocking native debugging needs the grapheneos kernel patches; hide the no-op
+    // toggle on kernels without /proc/self/attr/grapheneos_flags support
+    override fun getAvailabilityStatus() =
+        if (SELinuxFlags.kernelSupportsSELinuxFlags()) AVAILABLE else UNSUPPORTED_ON_DEVICE
+
     override fun getSummary(): CharSequence {
         return resText(if (setting.get(mContext)) R.string.aep_default_summary_allowed_for_3p_apps else R.string.aep_default_summary_blocked)
     }
@@ -89,6 +101,9 @@ class AppDefaultNativeDebuggingFragment : BoolSettingFragment() {
 class NativeDebuggingAppListPrefController(context: Context, preferenceKey: String) :
     AswAppListPrefController(context, preferenceKey, AswAdapterNativeDebugging) {
 
-    override fun getAvailabilityStatus() = ExtSettingControllerHelper
-        .getSecondaryUserOnlySettingAvailability(mContext)
+    // blocking native debugging needs the grapheneos kernel patches; hide the no-op
+    // toggle on kernels without /proc/self/attr/grapheneos_flags support
+    override fun getAvailabilityStatus() =
+        if (SELinuxFlags.kernelSupportsSELinuxFlags()) ExtSettingControllerHelper
+            .getSecondaryUserOnlySettingAvailability(mContext) else UNSUPPORTED_ON_DEVICE
 }
