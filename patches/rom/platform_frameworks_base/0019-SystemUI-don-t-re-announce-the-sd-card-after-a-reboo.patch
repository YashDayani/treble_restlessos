     private Notification onVolumeChecking(VolumeInfo vol) {
+        // vold reads the fs UUID only after it starts checking, so a card that is still unknown
+        // here may be the one being remounted at boot
+        if (inBootRemountWindow() && (vol.getFsUuid() == null
+                || mShutdownVolumes.contains(vol.getFsUuid()))) {
+            return null;
+        }
+
         final DiskInfo disk = vol.getDisk();
         final CharSequence title = mContext.getString(
                 R.string.ext_media_checking_notification_title, disk.getDescription());
@@ -405,6 +466,13 @@ public class StorageNotification implements CoreStartable {
         if (rec == null || (rec.isSnoozed() && disk.isAdoptable())) {
             return null;
