+    private final BroadcastReceiver mShutdownReceiver = new BroadcastReceiver() {
+        @Override
+        public void onReceive(Context context, Intent intent) {
+            final Set<String> mounted = new ArraySet<>();
+            for (VolumeInfo vol : mStorageManager.getVolumes()) {
+                if (vol.getType() == VolumeInfo.TYPE_PUBLIC && vol.isMountedReadable()
+                        && vol.getFsUuid() != null) {
+                    mounted.add(vol.getFsUuid());
+                }
+            }
+            getPrefs().edit().putStringSet(KEY_SHUTDOWN_VOLUMES, mounted).commit();
