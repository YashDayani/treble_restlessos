+        final Set<String> shutdownVolumes = prefs.getStringSet(KEY_SHUTDOWN_VOLUMES, null);
+        if (shutdownVolumes != null) {
+            mShutdownVolumes.addAll(shutdownVolumes);
+            prefs.edit().remove(KEY_SHUTDOWN_VOLUMES).apply();
+        }
+        mBootRemountDeadline = SystemClock.elapsedRealtime() + BOOT_REMOUNT_WINDOW_MS;
+
