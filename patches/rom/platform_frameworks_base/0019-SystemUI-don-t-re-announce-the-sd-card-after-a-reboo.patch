+        // Don't announce a card that was already mounted before the device rebooted
+        if (inBootRemountWindow() && mShutdownVolumes.contains(vol.getFsUuid())) {
+            mQuietVolumes.add(vol.getFsUuid());
+        }
+        if (mQuietVolumes.contains(vol.getFsUuid())) {
+            return null;
+        }
         if (disk.isAdoptable() && !rec.isInited() && rec.getType() != VolumeInfo.TYPE_PUBLIC
